DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# Server-only credential used to verify the one-time token returned by MSG91.
MSG91_AUTH_KEY=your-msg91-auth-key
# The OTP widget ID/token are intentionally public because the browser must initialize MSG91's widget.
NEXT_PUBLIC_MSG91_WIDGET_ID=your-msg91-widget-id
NEXT_PUBLIC_MSG91_WIDGET_TOKEN=your-msg91-widget-token
# Public canonical app URL. Required for Google OAuth in production.
APP_URL=http://localhost:3000
